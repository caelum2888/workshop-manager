# Copie para .env e ajuste. SECRET_KEY é sempre obrigatória (dev e produção) e
# precisa ter 32+ caracteres aleatórios — sem ela, ou curta demais, o app recusa
# iniciar. Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# (no uso diário via iniciar.bat, isso é feito automaticamente.)

APP_ENV=development
SECRET_KEY=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=oficinas_session

# Banco de dados (padrão: SQLite em data/oficinas.db).
# Exemplo PostgreSQL: postgresql+psycopg://usuario:senha@localhost:5432/oficinas
DATABASE_URL=

# IA opcional para consolidar textos do relatório (API da Anthropic).
# Sem chave, o sistema usa a consolidação simples dos registros originais.
LLM_API_KEY=
LLM_MODEL=claude-opus-5
